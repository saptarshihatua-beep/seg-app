<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Project4aSecureEnhancedGeolocking.pdf - Access Boundary</name>
    <description>Geolocked Area for Recipient: ashish@uccs.edu at Engineering Building, 1420 Austin Bluffs Parkway, Colorado Springs, CO 80918</description>
    <Style id="segPolygonStyle">
      <LineStyle>
        <color>ff0000ff</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>4d0000ff</color>
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
    </Style>
    <Placemark>
      <name>Project4aSecureEnhancedGeolocking.pdf Zone</name>
      <description>Physical authorization boundary. Receiver must be within this perimeter to decrypt.</description>
      <styleUrl>#segPolygonStyle</styleUrl>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              -104.800769,38.894143,0 -104.801091,38.893867,0 -104.79976,38.893178,0 -104.799589,38.893445,0 -104.800769,38.894143,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
</kml>