# Secure Enhanced Geolocking (SEG) Server Configuration

PORT=5000
NODE_ENV=development
JWT_SECRET=seg_super_secret_jwt_key_9837428492019482
JWT_EXPIRES_IN=24h

# Database Configuration
# Set to 'mysql' to connect to MySQL database, or 'sqlite' for zero-config file database, or 'auto'
DB_TYPE=auto
DB_HOST=localhost
