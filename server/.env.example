# File Storage
UPLOAD_DIR=uploads
KML_DIR=uploads/kml

# Security Parameters
MAX_LOCATION_AGE_SECONDS=60
MAX_ALLOWED_ACCURACY_METERS=150
TOKEN_EXPIRY_MINUTES=60

# Frontend URL
CLIENT_URL=http://localhost:5173
