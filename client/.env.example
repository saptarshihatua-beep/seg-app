# Google Maps JavaScript API Key (Optional)
# If provided, SEG automatically initializes Google Maps instead of Leaflet.
# Leave blank to use 100% free offline Leaflet / OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=

# Backend API URL (Optional - defaults to /api when running locally)
# Set when deployed to Netlify (e.g., https://your-backend.onrender.com/api)
# VITE_API_BASE_URL=
